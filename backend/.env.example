# ==============================================================================
# GateFlow — Variáveis de Ambiente (Fase 4: M-Pesa / Checkout Online)
# ==============================================================================
# Copie este ficheiro para ".env" (ou exporte as variáveis diretamente no seu
# processo/servidor) e preencha com as credenciais REAIS do comerciante antes
# de aceitar pagamentos em produção.
#
# Em MPESA_ENV=sandbox, se MPESA_API_KEY/MPESA_PUBLIC_KEY/MPESA_SHORTCODE não
# forem definidos, o sistema usa automaticamente os valores de exemplo
# públicos da documentação oficial da Vodacom Moçambique (ver mpesa_service.py)
# — suficiente para testar o fluxo completo de ponta a ponta sem cadastro
# prévio. Em MPESA_ENV=production essas três variáveis são OBRIGATÓRIAS.

# sandbox | production
MPESA_ENV=sandbox

# Credenciais do comerciante fornecidas pela Vodacom no portal de
# desenvolvedores (developer.mpesa.vm.co.mz) ao aprovar a sua conta.
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SHORTCODE=

# Cabeçalho Origin exigido pela API iPG. O valor abaixo é o padrão aceite
# pelo sandbox; em produção, use o domínio autorizado para a sua conta.
MPESA_ORIGIN=developer.mpesa.vm.co.mz

# Timeout (segundos) para as chamadas HTTP à M-Pesa. O C2B Single Stage
# aciona um USSD Push que espera o cliente digitar o PIN — pode legitimamente
# demorar, então o timeout é mais generoso que uma chamada de API comum.
MPESA_REQUEST_TIMEOUT_SECONDS=35

# print() no terminal com o status code e o corpo JSON completo de toda
# chamada à M-Pesa (nunca imprime o Bearer token/chaves) — útil na fase
# de testes. Padrão: ligado em sandbox, desligado em produção.
MPESA_DEBUG_LOGS=1

# URL pública do próprio GateFlow (ex: https://meudominio.com), usada para
# montar o link de download dos bilhetes enviado por WhatsApp/e-mail. Se
# vazio, usa o host da própria requisição em tempo de execução.
GATEFLOW_PUBLIC_BASE_URL=

# Taxa de serviço SaaS do GateFlow sobre cada bilhete vendido ONLINE (0.05 = 5%)
GATEFLOW_SERVICE_FEE_RATE=0.05

# Duração (minutos) da reserva atômica de estoque durante o checkout online
GATEFLOW_ORDER_HOLD_MINUTES=5

# ==============================================================================
# Fase 5 — Notificações (E-mail / SMS)
# ==============================================================================
# Se SMTP_HOST não for definido, o envio de e-mail fica desativado (o sistema
# continua funcionando normalmente, só não envia o PDF por e-mail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=bilhetes@gateflow.co.mz
SMTP_FROM_NAME=GateFlow

# Provider de SMS ativo (ver sms_service.py). "console" apenas loga a
# mensagem — trocar para o nome do gateway real quando integrado.
SMS_PROVIDER=console

# Provider de WhatsApp ativo (ver whatsapp_service.py), primeira opção
# de entrega dos bilhetes. "console" apenas loga a mensagem (cai para
# e-mail automaticamente) — trocar para o nome do gateway real (ex: a
# WhatsApp Business Cloud API da Meta, ou um agregador como Twilio)
# quando integrado.
WHATSAPP_PROVIDER=console

# ==============================================================================
# Fase 5 — Rate Limiting
# ==============================================================================
# Armazenamento do Flask-Limiter. "memory://" funciona para 1 processo; em
# produção com múltiplos workers Gunicorn, usar um Redis compartilhado:
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

DATABASE_URL=postgresql://neondb_owner:SUA_SENHA_COMPLETA_AQUI@ep-noisy-queen-axjbpsd9.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require